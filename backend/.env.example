# ================================================
# AIDA Imprenta Digital - Variables de Entorno
# ================================================
# Copie este archivo como .env y configure los valores

# --- Aplicacion ---
APP_NAME="AIDA - Imprenta Digital"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
# Origenes permitidos (separados por coma para produccion)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004","http://localhost:3005"]

# --- Base de Datos (PostgreSQL 16) ---
DATABASE_URL=postgresql+asyncpg://aida:aida_secret_2024@localhost:5432/aida_db
DATABASE_ECHO=false

# --- Redis 7 ---
REDIS_URL=redis://localhost:6379/0

# --- Seguridad JWT ---
SECRET_KEY=CAMBIAR-EN-PRODUCCION-usar-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 2FA ---
OTP_ISSUER=AIDA

# --- SENIAT ---
SENIAT_API_URL=
SENIAT_API_KEY=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
SMTP_FROM_EMAIL=noreply@aida.com.ve

# --- AI / LLM ---
# Proveedores: groq | anthropic | openai
AI_PROVIDER=groq
AI_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3

# --- Almacenamiento ---
# Backends: local | s3
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage

# --- Paginacion ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
